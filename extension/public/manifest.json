{
  "manifest_version": 3,
  "name": "Monk Mode Blocker",
  "version": "0.1.0",
  "description": "Blocks Shorts and Reels, and measures your daily allowance for the Monk Mode app.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "storage", "declarativeNetRequest", "alarms", "idle"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "action": {
    "default_title": "Monk Mode",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "shorts", "enabled": true, "path": "shorts-rules.json" }
    ]
  },
  "web_accessible_resources": [
    { "resources": ["block.html"], "matches": ["<all_urls>"] }
  ]
}
