{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monk Mode",
  "mainBinaryName": "monk-mode-app",
  "version": "0.1.0",
  "identifier": "com.tokiosman96.monkmode",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:bundle"
  },
  "app": {
    "windows": [
      {
        "title": "Monk Mode",
        "dragDropEnabled": false,
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "center": true,
        "create": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "../../installer/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
