{
  "name": "monk-mode-blocker",
  "private": true,
  "type": "module",
  "workspaces": [
    "app",
    "extension"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check . && npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "format": "prettier --write . && cargo fmt --all",
    "icons": "npm run tauri -w app -- icon src-tauri/icon-source.svg && npm run tauri -w app -- icon src-tauri/icon-source.svg --png 16,32,48,128 -o ../extension/public/icons"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
